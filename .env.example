# Copy to services/api/.env for local development. Never commit real secrets.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://sdlc:sdlc@localhost:5432/sdlc

# Development sign-in accounts (refused when APP_ENV=production)
DEV_SEED_USERS=true

# Optional: OpenAI-compatible model endpoint, e.g. vLLM serving a Qwen model.
# Leave unset to run rule-based skill strategies (clearly labeled in the UI).
# MODEL_ENDPOINT_URL=http://localhost:8001/v1
# MODEL_ENDPOINT_API_KEY=

# Local model (default): mlx_lm.server on Apple silicon. ./dev.sh --llm starts it and sets
# MLX_LM_URL; set MLX_LM_URL yourself to use a server you start separately.
# MLX_LM_DIR=~/path/to/dir-whose-.venv-has-mlx-lm
# MLX_LM_MODEL=mlx-community/Qwen3-4B-Instruct-2507-4bit
# MLX_LM_URL=http://127.0.0.1:8001/v1

# Claude (Anthropic API). Hosted, so it is only used when MODEL_PRIVACY_POLICY=any; the local
# model still ranks first when it is running. See docs/operations/models.md.
# ANTHROPIC_API_KEY=
# MODEL_PRIVACY_POLICY=any

# Logging: LOG_LEVEL (DEBUG, INFO, WARNING, ERROR) and LOG_FORMAT (json | text). ./dev.sh sets
# text, and DEBUG with --debug. SQL_ECHO=true logs every database query.
# LOG_LEVEL=INFO
# LOG_FORMAT=json

# Sandbox backend: namespace (needs root/CAP_SYS_ADMIN for the worker) | docker | none (tests only)
SANDBOX_BACKEND=namespace

# Production deployment stays disabled until explicitly configured and approved.
PRODUCTION_DEPLOY_ENABLED=false

